<Window x:Class="AOGBogballeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AOG Bogballe Bridge"
        Height="450"
        Width="400">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COM Port Selection -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="COM Port" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200"
                          ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}"/>
                <Button Content="Refresh"
                        Command="{Binding RefreshPortsCommand}"
                        Margin="10,0,0,0"
                        Padding="10,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Communication Status -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Communication Status"
                       FontWeight="Bold"
                       FontSize="14"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="UDP:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Ellipse Grid.Column="1" 
                         Width="20" 
                         Height="20" 
                         Fill="{Binding UdpBrush}"
                         HorizontalAlignment="Left"
                         Margin="10,0,0,0"/>

                <TextBlock Grid.Column="2" Text="Serial:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Ellipse Grid.Column="3" 
                         Width="20" 
                         Height="20" 
                         Fill="{Binding SerialBrush}"
                         HorizontalAlignment="Left"
                         Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Live Data Display -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Live Data"
                       FontWeight="Bold"
                       FontSize="14"/>

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed:" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="Bold">
                    <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/>
                    <Run Text=" km/h"/>
                </TextBlock>

                <!-- Rate -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rate:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="16" FontWeight="Bold" Margin="0,5,0,0">
                    <Run Text="{Binding Rate, StringFormat='{}{0:F0}'}"/>
                </TextBlock>

                <!-- Width -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Width:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="16" FontWeight="Bold" Margin="0,5,0,0">
                    <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/>
                    <Run Text=" m"/>
                </TextBlock>

                <!-- Last PGN -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Last PGN:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding LastPgn}"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,5,0,0"/>

                <!-- Machine configuration -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Config:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding ConfigText}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Sections -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Sections"
                       FontWeight="Bold"
                       FontSize="14"/>

            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5"
                                Height="30"
                                BorderBrush="DarkGray"
                                BorderThickness="2"
                                CornerRadius="4"
                                Background="{Binding}">
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </Grid>
</Window>
