<Window x:Class="AOGBogballeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AOGBogballeBridge"
        x:Name="MainWindowRoot"
        Title="AOG Bogballe Bridge"
        Icon="AgOpenGPS Bogballe.ico"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
      <Grid x:Name="FullLayout" Margin="16" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Padding="12"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Minimal display" Click="ShowMinimalDisplay"
                            Padding="10,4" Margin="8,0,0,0"/>
                    <TextBlock Text="Connection and live data" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="COM Port" FontWeight="SemiBold" Margin="0,10,0,3"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh"
                            Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" Padding="10,3"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="UDP:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Grid.Column="1" Width="16" Height="16" Fill="{Binding UdpBrush}" HorizontalAlignment="Left" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="Serial:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Grid.Column="3" Width="16" Height="16" Fill="{Binding SerialBrush}" HorizontalAlignment="Left" Margin="8,0"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            BorderBrush="LightSteelBlue" BorderThickness="1" Background="#EEF5FB"
                            CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Speed" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontWeight="Bold" FontSize="22" Foreground="DarkSlateBlue"
                                       Margin="12,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                            BorderBrush="LightSteelBlue" BorderThickness="1" Background="#EEF5FB"
                            CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target rate" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                                       FontWeight="Bold" FontSize="24" Foreground="DarkSlateBlue"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            BorderBrush="LightSteelBlue" BorderThickness="1" Background="#EEF5FB"
                            CornerRadius="4" Padding="8,4" Margin="0,4,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Width" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock FontWeight="Bold" FontSize="22" Foreground="DarkSlateBlue"
                                       Margin="12,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding GpsStatus}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding GpsCoordinateText}"/>
                    <TextBlock Text="{Binding CurrentApplicationRate, Mode=OneWay}" Foreground="DarkSlateBlue"/>
                    <TextBlock Text="{Binding Rate, StringFormat='Spreader-reported rate: {0:F0}', Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="{Binding ConfigText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,8,12" Padding="12"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Sections" FontWeight="Bold" FontSize="15"/>
                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="2" Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Height="28" BorderBrush="DarkGray" BorderThickness="1"
                                    CornerRadius="3" Background="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" Padding="12"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Variable-rate shapefile" FontWeight="Bold" FontSize="15"/>
                <Button Content="Load shapefile..." Command="{Binding LoadShapefileCommand}"
                        HorizontalAlignment="Left" Padding="12,5" Margin="0,10,0,6"/>
                <TextBlock Text="{Binding ShapefileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="DBF field to preview" Margin="0,8,0,3"/>
                <ComboBox ItemsSource="{Binding ShapefileFields}" SelectedItem="{Binding SelectedShapefileField}"/>
                <TextBlock Text="Numeric fields shade features from low (blue) to high (red)."
                           FontSize="11" Foreground="DimGray" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding ShapefileStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="DarkGray" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <local:ShapefileMap Features="{Binding ShapefileFeatures, Mode=OneWay}"
                                ValueField="{Binding SelectedShapefileField, Mode=OneWay}"
                                IsGeographic="{Binding IsShapefileGeographic, Mode=OneWay}"
                                GpsPositionValid="{Binding GpsPositionValid, Mode=OneWay}"
                                GpsLatitude="{Binding GpsLatitude, Mode=OneWay}"
                                GpsLongitude="{Binding GpsLongitude, Mode=OneWay}"/>
        </Border>
      </Grid>

      <Grid x:Name="MinimalLayout" Visibility="Collapsed" Background="#FF202830" Margin="4"
            MouseLeftButtonDown="MinimalLayout_MouseLeftButtonDown" Cursor="SizeAll"
            ToolTip="Drag to reposition">
          <Grid.LayoutTransform>
              <ScaleTransform ScaleX="3" ScaleY="3"/>
          </Grid.LayoutTransform>
          <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,24,0">
              <TextBlock Text="SPEED" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="WIDTH" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0"
                      Visibility="{Binding ShapefileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="RATE" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                         Margin="8,0,0,0" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="3" Click="ShowFullDisplay" Padding="12,6"
                  VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Return to the full window (Esc)"
                  AutomationProperties.Name="Return to full window">
              <Viewbox Width="16" Height="16" Stretch="Uniform">
                  <Canvas Width="24" Height="24">
                      <Path Data="M 9,3 H 3 V 9 M 15,3 H 21 V 9 M 21,15 V 21 H 15 M 9,21 H 3 V 15"
                            Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                  </Canvas>
              </Viewbox>
          </Button>
      </Grid>
    </Grid>
</Window>
